# AURA gateway configuration. Copy to .env and fill. NEVER commit .env.
#
# Deployment: the gateway runs on Linux (Jetson Orin / AI Max / any AMD64 or
# ARM64 host). The development Mac is only used for flashing firmware.
# AI_PROVIDER accepts exactly: gemini | ollama | llamacpp

# ---------------------------------------------------------------------------
# Pet identity and behavior
# ---------------------------------------------------------------------------
PET_NAME=AURA
PET_PERSONALITY=playful_assistant
PET_TIMEZONE=Asia/Bangkok
PET_DEFAULT_CITY=Bangkok

# ---------------------------------------------------------------------------
# LLM provider selection (exactly one)
# ---------------------------------------------------------------------------
AI_PROVIDER=gemini

# ---------------------------------------------------------------------------
# Gemini (cloud; optional; google-genai SDK; uv sync --extras gemini)
# GEMINI_BASE_URL is only for SDK-compatible endpoint overrides (proxy);
# leave empty for the Google default.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=
GEMINI_TIMEOUT_SECONDS=30
GEMINI_TEMPERATURE=0.7
GEMINI_TOP_P=0.9

# ---------------------------------------------------------------------------
# Ollama (native HTTP API: /api/chat, /api/tags) - can be remote!
# Works with localhost, IPv4, IPv6 ([::1] or [fd00::1]...), LAN hostnames,
# FQDNs and https:// endpoints. Do NOT append /api/... to the base URL.
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
# OLLAMA_AUTH_MODE: none (default; no key needed) or bearer (reverse proxy /
# authenticated deployment).
OLLAMA_AUTH_MODE=none
OLLAMA_API_KEY=
OLLAMA_TIMEOUT_SECONDS=45
OLLAMA_TEMPERATURE=0.8
OLLAMA_TOP_P=0.9

# ---------------------------------------------------------------------------
# llama.cpp llama-server (OpenAI-compatible API) - can be remote!
# Give the base URL WITH or WITHOUT /v1; never appended twice.
# Endpoints used: /v1/models, /v1/chat/completions.
# No dummy API key is ever sent: with AUTH_MODE=none no Authorization header
# goes out; with=bearer your own token is sent.
# ---------------------------------------------------------------------------
LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
LLAMACPP_MODEL=
LLAMACPP_AUTH_MODE=none
LLAMACPP_API_KEY=
LLAMACPP_TIMEOUT_SECONDS=45
LLAMACPP_TEMPERATURE=0.7

# ---------------------------------------------------------------------------
# Provider failover (explicit and optional). Cloud failover is OFF by
# default: a failing local provider NEVER silently forwards prompts to Gemini.
# Example (local-only chain): LLM_FAILOVER_CHAIN=ollama,llamacpp
# ---------------------------------------------------------------------------
LLM_FAILOVER_CHAIN=
ALLOW_CLOUD_FAILOVER=false
# Check configured model IDs against the provider's model list when possible.
VALIDATE_MODEL_IDS=true

# ---------------------------------------------------------------------------
# STT (independent of LLM; does NOT assume Ollama/llama.cpp do speech)
# STT_PROVIDER: faster_whisper | gemini
# ---------------------------------------------------------------------------
STT_PROVIDER=faster_whisper
STT_MODEL_SIZE=base

# ---------------------------------------------------------------------------
# TTS (independent of LLM)
# Voice models:
#   uv run --extra piper python -m piper.download_voices --download-dir ./voices en_US-lessac-medium
# ---------------------------------------------------------------------------
TTS_PROVIDER=piper
TTS_VOICE_PATH=
TTS_VOICE=en_US-lessac-medium

# ---------------------------------------------------------------------------
# Wake word / acknowledgment
# Gateway-side wake uses ASR + keyword regex on transcribed audio
# (docs/wake-word.md): WAKE_REGEX does NOT create a local wake-word detector,
# it only matches what STT heard. Touch to-talk on the device is the
# always-available fallback.
# ---------------------------------------------------------------------------
WAKE_ENABLED=false
WAKE_REGEX=^(hey[ ,]*aura|aura[ ,]*robot|aura)\b
WAKE_MAX_AUDIO_S=10
WAKE_MIN_RMS=500
WAKE_ACK_ENABLED=true
WAKE_ACK_PHRASES=Yes?,I'm here.,You called?,What's up?,I'm listening.

# ---------------------------------------------------------------------------
# Gateway / network
# ---------------------------------------------------------------------------
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8765
GATEWAY_DATA_DIR=./data
# Verify TLS on outbound provider calls (keep true in production).
TLS_VERIFY_OUTBOUND=true
RATE_LIMIT_PER_MIN=60

# ---------------------------------------------------------------------------
# Authentication and logging
# DEVICE_AUTH_TOKEN: shared device token (empty = open LAN, dev only!).
# ADMIN_TOKEN: gateway admin API (provider switching). Empty = admin API
# disabled. NEVER put either token in firmware or the provisioning page.
# ---------------------------------------------------------------------------
DEVICE_AUTH_TOKEN=
ADMIN_TOKEN=
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Memory
# ---------------------------------------------------------------------------
ENABLE_MEMORY=true
HISTORY_MAX_MESSAGES=200
SUMMARISE_EVERY=20

# ---------------------------------------------------------------------------
# Weather (Open-Meteo, key-less)
# ---------------------------------------------------------------------------
ENABLE_WEATHER=true
WEATHER_DEFAULT_LAT=13.75
WEATHER_DEFAULT_LON=100.50

# ---------------------------------------------------------------------------
# Network diagnostics + bounded throughput test
# ---------------------------------------------------------------------------
ENABLE_NETWORK_DIAGNOSTICS=true

# ---------------------------------------------------------------------------
# Server monitoring (read-only, off by default; future: get_server_status,
# get_cpu_usage, get_memory_usage, get_disk_usage, get_container_status,
# get_service_health, get_ssl_expiration, get_recent_alerts).
# Never runs model-generated shell commands or unrestricted SSH.
# ---------------------------------------------------------------------------
ENABLE_SERVER_MONITORING=false

# Proactive speech (not yet implemented on-device)
ENABLE_PROACTIVE_SPEECH=false
