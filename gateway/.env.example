# AURA gateway configuration. Copy to .env and fill. NEVER commit .env.

# Device / personality
PET_NAME=AURA
PET_PERSONALITY=playful_assistant
PET_TIMEZONE=Asia/Bangkok
PET_DEFAULT_CITY=Bangkok

# LLM provider: gemini | ollama | openai_compatible
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=

# Local LLM alternative
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_FORMAT=json

# OpenAI-compatible endpoint (optional)
OPENAI_COMPAT_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_COMPAT_MODEL=

# Speech providers (STT and TTS independent of LLM)
# STT_PROVIDER: faster_whisper | gemini
STT_PROVIDER=faster_whisper
STT_MODEL_SIZE=base
TTS_PROVIDER=piper
TTS_VOICE_PATH=
TTS_VOICE=en_US-lessac-medium
# Voice models: uv run --extra piper python -m piper.download_voices en_US-lessac-medium

# Gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8765
# Shared device auth token (min 16 chars for production)
DEVICE_AUTH_TOKEN=
GATEWAY_DATA_DIR=./data

# Weather (Open-Meteo, key-less)
WEATHER_DEFAULT_LAT=13.75
WEATHER_DEFAULT_LON=100.50

# Features
ENABLE_MEMORY=true
ENABLE_WEATHER=true
ENABLE_NETWORK_DIAGNOSTICS=true
ENABLE_SERVER_MONITORING=false
ENABLE_PROACTIVE_SPEECH=false
